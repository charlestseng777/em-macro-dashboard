programme":{"status":"Successor programme talks","detail":"Talks on a successor IMF programme are expected to resume with the new government after the August elections."},"rating":null,"bonds":[],"bonds_label":null,"events":[{"date":"2026-09-30","label":"Fuel-tax suspension and zero-rated VAT expire"},{"date":"2026-09-30","label":"Bank of Zambia MPC (a cut is possible)"}],"windows":{"macro":{"as_of":"2026-09-22","points":[{"text":"Inflation eased to 6.1% in September, its lowest since February 2018.","src":["TradingView News"]},{"text":"One watch item: the fuel-tax suspension and zero-rated VAT expire on September 30.","src":[]},{"text":"The Bank of Zambia could cut again on 30 September after a 25bp cut in May took the policy rate to 13.25%. The IMF has revised 2026 growth down to 4.3%.","src":[]}]},"external":{"as_of":"2026-09-22","points":[{"text":"Reserves are $6.4bn, or 4.4 months of prospective imports. The current account is expected to move to a surplus of 1.5% of GDP.","src":["IMF","Channel Africa"]}]},"fiscal":{"as_of":"2026-09-22","points":[{"text":"The primary surplus is now projected at 1.1% of GDP for 2026, down from 3.8% at the sixth review. The IMF blamed weaker tax collection, pre-election spending, a wage adjustment and agricultural subsidy overruns.","src":["Mwebantu"]}]},"debt":{"as_of":"2026-09-22","points":[{"text":"Restructuring agreements now cover 94% of eligible debt.","src":["Channel Africa"]},{"text":"The government says annual external debt service falls below $900m, and it completed a buyback of the remaining $1.36bn 2053 Eurobond using $600m of AfDB concessional financing.","src":["Zambian Politics"]}]},"valuation":{"as_of":null,"points":[{"text":"Add post-restructuring Eurobond yields to the bonds list.","src":[]}]},"catalysts":{"as_of":"2026-09-22","points":[{"text":"Hichilema was re-elected with about 60% of the vote. Talks on a successor IMF programme are expected to resume with the new government, and a new programme deal is the obvious near-term catalyst.","src":["Discovery Alert","Dmarketforces"]}]}},"narrative_pending":false,"derived":{"interest":{},"policy_source":"Bank of Zambia","policy_rate":["2026-09-22",13.25],"real_rate":-0.66,"fx_changes":{"1w":3.99,"1m":3.25,"3m":7.93,"1y":-17.33,"ytd":-11.57},"auto":{"macro":["World Bank real GDP growth: 3.8% in 2025 (IMF WEO unavailable on this run).","World Bank CPI inflation: 13.9% in 2025 (IMF WEO unavailable on this run).","Policy rate 13.25% (2026-09-22); real rate ≈ -0.7% against World Bank 2025 CPI inflation of 13.9%."],"external":["World Bank current account (% GDP): -4.4% in 2024 (IMF WEO unavailable on this run).","USD/ZMW 19.6200 on 2026-10-02, ZMW weaker by 3.2% over 1m; -11.6% YTD.","Reserves $4.1bn at end-2024 (World Bank), 3.3 months of imports."],"fiscal":["World Bank central govt debt (% GDP): 71.4% in 2021 (IMF WEO unavailable on this run)."],"debt":["External debt $28.1bn at end-2024 (World Bank IDS); debt service 30% of exports (2024).","Central government interest payments: 28% of revenue (2024, World Bank)."],"valuation":[],"catalysts":["8 headlines in the last 14 days (below)."]}},"windows_stale":{"macro":false,"external":false,"fiscal":false,"debt":false,"valuation":true,"catalysts":false},"updated":"2026-10-02T11:20:51+00:00"}